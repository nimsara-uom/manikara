{
  "name": "manikara",
  "version": "0.1.0",
  "private": true,
  "description": "Manikara — fine gemstone auctions with signed gem keys",
  "scripts": {
    "setup": "node scripts/setup.mjs && prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx prisma/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "settle": "tsx scripts/settle.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.2.13",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
